        { "id": "yy-vendor", "label": "供应商", "ph": "参照供应商档案，必录" },
        { "id": "yy-dept", "label": "部门", "options": ["采购部", "生产部", "项目部"] },
        { "id": "yy-biz", "label": "业务员", "ph": "默认当前操作员" }
      ]
    },
    {
      "type": "fields",
      "title": "单据表体",
      "items": [
        { "id": "yy-inv", "label": "存货编码", "ph": "如 0101001" },
        { "id": "yy-qty", "label": "数量", "ph": "如 100" },
        { "id": "yy-price", "label": "含税单价", "ph": "如 113.00" }
      ]
    },
    {
      "type": "table",
      "id": "yy-grid",
      "title": "存货明细",
