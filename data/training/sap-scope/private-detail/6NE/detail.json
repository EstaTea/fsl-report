 "description_en_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>Securities Option Management – Group Ledger IFRS (6NE)</title>\n </head>\n <body id=\"loio0755b8bd8cb74ccc91677d63df9dcd03\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio0755b8bd8cb74ccc91677d63df9dcd03__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">Overview</h2>\n      <p class=\"p\">By activating parallel valuation for Securities Option Management – Group Ledger IFRS, you can use an additional valuation area other than your operational valuation area according to International Financial Reporting Standards (IFRS 9).</p>\n     </section>\n     <section class=\"section\" id=\"loio0755b8bd8cb74ccc91677d63df9dcd03__key_process_flow\">\n      <h2 class=\"title sectiontitle\">Key Process Flow</h2>\n      <ul class=\"ul\" id=\"loio0755b8bd8cb74ccc91677d63df9dcd03__ul_b2l_fyd_hxb\">\n       <li class=\"li\">Post to General Ledger</li>\n       <li class=\"li\">Perform Key Date Valuation</li>\n       <li class=\"li\">Post Realized Profit and Loss</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio0755b8bd8cb74ccc91677d63df9dcd03__business_benefits\">\n      <h2 class=\"title sectiontitle\">Business Benefits</h2>\n      <ul class=\"ul\" id=\"loio0755b8bd8cb74ccc91677d63df9dcd03__ul_vgs_gyd_hxb\">\n       <li class=\"li\">Generate all general ledger postings</li>\n       <li class=\"li\">Update the general ledger according to IFRS9</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
 "description_zh_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>证券期权管理 – 集团分类账 IFRS (6NE)</title>\n </head>\n <body id=\"loio0755b8bd8cb74ccc91677d63df9dcd03\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio0755b8bd8cb74ccc91677d63df9dcd03__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">概览</h2>\n      <p class=\"p\">通过激活证券期权管理 – 集团分类账 IFRS 的并行评估，您可以根据国际财务报告标准 (IFRS 9) 使用除运营评估范围以外的其他评估范围。</p>\n     </section>\n     <section class=\"section\" id=\"loio0755b8bd8cb74ccc91677d63df9dcd03__key_process_flow\">\n      <h2 class=\"title sectiontitle\">关键流程流</h2>\n      <ul class=\"ul\" id=\"loio0755b8bd8cb74ccc91677d63df9dcd03__ul_b2l_fyd_hxb\">\n       <li class=\"li\">过账到总账</li>\n       <li class=\"li\">执行关键日期评估</li>\n       <li class=\"li\">过账已实现损益</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio0755b8bd8cb74ccc91677d63df9dcd03__business_benefits\">\n      <h2 class=\"title sectiontitle\">业务优势</h2>\n      <ul class=\"ul\" id=\"loio0755b8bd8cb74ccc91677d63df9dcd03__ul_vgs_gyd_hxb\">\n       <li class=\"li\">生成所有总账过账</li>\n       <li class=\"li\">根据 IFRS9 更新总账</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
