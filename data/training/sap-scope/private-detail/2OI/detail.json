 "description_en_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>Intercompany Debt and Investment Mgmt – Group Ledger IFRS (2OI)</title>\n </head>\n <body id=\"loio688917a251694d8b80bd6a82608297c7\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio688917a251694d8b80bd6a82608297c7__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">Overview</h2>\n      <p class=\"p\">This scope item allows the company to post the accounting in a parallel valuation area when it handles loans with an affiliate company.</p>\n     </section>\n     <section class=\"section\" id=\"loio688917a251694d8b80bd6a82608297c7__key_process_flow\">\n      <h2 class=\"title sectiontitle\">Key Process Flow</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Post flows to the general ledger in a parallel valuation area</li>\n       <li class=\"li\">Post additional flows to the general ledger in parallel valuation area for current account style instrument intercompany transaction</li>\n       <li class=\"li\">Perform key date valuation in the parallel valuation area for period-end closing</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio688917a251694d8b80bd6a82608297c7__business_benefits\">\n      <h2 class=\"title sectiontitle\">Business Benefits</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Evaluate and record accounting activities per IFRS standards</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
 "description_zh_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>公司间债务与投资管理 – 集团分类账 IFRS (2OI)</title>\n </head>\n <body id=\"loio688917a251694d8b80bd6a82608297c7\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio688917a251694d8b80bd6a82608297c7__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">概览</h2>\n      <p class=\"p\">此范围项目允许公司在处理联营公司的贷款时，在并行评估范围中过账会计核算。</p>\n     </section>\n     <section class=\"section\" id=\"loio688917a251694d8b80bd6a82608297c7__key_process_flow\">\n      <h2 class=\"title sectiontitle\">关键流程流</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">将流过账到并行评估范围中的总账。</li>\n       <li class=\"li\">针对现金账户型利率工具公司间交易，将附加流过账到并行评估范围中的总账</li>\n       <li class=\"li\">在期末关账的并行评估范围中执行关键日期评估。</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio688917a251694d8b80bd6a82608297c7__business_benefits\">\n      <h2 class=\"title sectiontitle\">业务优势</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">根据 IFRS 标准评估和记录会计核算活动</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
