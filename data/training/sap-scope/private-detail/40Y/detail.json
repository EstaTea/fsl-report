 "description_en_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>Intercompany Reconciliation Process (40Y)</title>\n </head>\n <body id=\"loio8e9375a6617347399426817a973ed8e6\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio8e9375a6617347399426817a973ed8e6__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">Overview</h2>\n      <p class=\"p\">This scope item covers the process of reconciling the accounting documents that describe the accounting transactions within a corporate group in accordance with the predefined matching method. It allows early analysis in the closing process to avoid differences altogether and to reduce the deadline pressure that normally arises during the end of a closing period.</p>\n     </section>\n     <section class=\"section\" id=\"loio8e9375a6617347399426817a973ed8e6__key_process_flow\">\n      <h2 class=\"title sectiontitle\">Key Process Flow</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Run matching</li>\n       <li class=\"li\">Check reconciliation status</li>\n       <li class=\"li\">Check reconciliation balance</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio8e9375a6617347399426817a973ed8e6__business_benefits\">\n      <h2 class=\"title sectiontitle\">Business Benefits</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Get real-time reconciliation and error detection</li>\n       <li class=\"li\">Speed up the month-end closing</li>\n       <li class=\"li\">Streamline company to corporate closing integration</li>\n       <li class=\"li\">Save operational costs with automatic processes</li>\n       <li class=\"li\">Get multi-dimensional reconciliation with multi-valuation to support both legal and management-used reconciliation</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
 "description_zh_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>公司间对账流程 (40Y)</title>\n </head>\n <body id=\"loio8e9375a6617347399426817a973ed8e6\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio8e9375a6617347399426817a973ed8e6__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">概览</h2>\n      <p class=\"p\">此范围项目涵盖对账会计凭证的流程，会计凭证根据预定义的匹配方法描述公司集团内的会计交易。它允许在关账流程中进行早期分析，从而完全避免差异，并减少通常在关账期间结束时产生的截止日期压力。</p>\n     </section>\n     <section class=\"section\" id=\"loio8e9375a6617347399426817a973ed8e6__key_process_flow\">\n      <h2 class=\"title sectiontitle\">关键流程流</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">运行匹配</li>\n       <li class=\"li\">检查对账状态</li>\n       <li class=\"li\">检查对账余额</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio8e9375a6617347399426817a973ed8e6__business_benefits\">\n      <h2 class=\"title sectiontitle\">业务优势</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">获取实时对账和错误检测</li>\n       <li class=\"li\">加快月末结算</li>\n       <li class=\"li\">简化公司到公司关账的集成</li>\n       <li class=\"li\">通过自动流程节省运营成本</li>\n       <li class=\"li\">通过多评估获取多维对账，以支持法律和管理使用的对账</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
