 "description_en_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>Embargo Control (1WC)</title>\n </head>\n <body id=\"loioe5b144c621204ae383694522d428a6a6\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loioe5b144c621204ae383694522d428a6a6__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">Overview</h2>\n      <p class=\"p\">This scope item supports international trade compliance by identifying embargoed countries or regions for automated checking of business transactions. Transactions blocked for embargo control may be reviewed and released as appropriate.</p>\n     </section>\n     <section class=\"section\" id=\"loioe5b144c621204ae383694522d428a6a6__key_process_flow\">\n      <h2 class=\"title sectiontitle\">Key Process Flow</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Manage embargo list</li>\n       <li class=\"li\">Block relevant transactions with embargoed countries/regions automatically</li>\n       <li class=\"li\">Resolve documents with an embargo block</li>\n       <li class=\"li\">Display compliance documents</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loioe5b144c621204ae383694522d428a6a6__business_benefits\">\n      <h2 class=\"title sectiontitle\">Business Benefits</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Support compliance of international trade</li>\n       <li class=\"li\">Keep international trade processes frictionless</li>\n       <li class=\"li\">Avoid financial loss</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
 "description_zh_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>禁运控制 (1WC)</title>\n </head>\n <body id=\"loioe5b144c621204ae383694522d428a6a6\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loioe5b144c621204ae383694522d428a6a6__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">概览</h2>\n      <p class=\"p\">此范围项目通过识别禁运国家或地区来支持国际贸易合规性，以自动检查业务交易。冻结禁运控制的交易可能会根据需要进行审查和释放。</p>\n     </section>\n     <section class=\"section\" id=\"loioe5b144c621204ae383694522d428a6a6__key_process_flow\">\n      <h2 class=\"title sectiontitle\">关键流程流</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">管理禁运清单</li>\n       <li class=\"li\">自动冻结与禁运国家/地区的相关交易</li>\n       <li class=\"li\">解决含禁运冻结的凭证</li>\n       <li class=\"li\">显示合规性文档</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loioe5b144c621204ae383694522d428a6a6__business_benefits\">\n      <h2 class=\"title sectiontitle\">业务优势</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">支持国际贸易合规性</li>\n       <li class=\"li\">保持国际贸易流程顺畅</li>\n       <li class=\"li\">避免财务损失</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
