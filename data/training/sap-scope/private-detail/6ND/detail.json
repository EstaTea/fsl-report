 "description_en_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>Securities Option Management (6ND)</title>\n </head>\n <body id=\"loio99a90b074d8048dd8687b3b493e676d6\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio99a90b074d8048dd8687b3b493e676d6__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">Overview</h2>\n      <p class=\"p\">The scope item helps you to better manage your Securities Option instruments.</p>\n      <p class=\"p\">It helps you to automate labor-intensive processes, such as payment handling and accounting postings, giving you more time to focus on value-added activities. You can manage operational and accounting requirements.</p>\n     </section>\n     <section class=\"section\" id=\"loio99a90b074d8048dd8687b3b493e676d6__key_process_flow\">\n      <h2 class=\"title sectiontitle\">Key Process Flow</h2>\n      <ul class=\"ul\" id=\"loio99a90b074d8048dd8687b3b493e676d6__ul_tbk_wrc_hxb\">\n       <li class=\"li\">Create security account and class</li>\n       <li class=\"li\">Create securities option transaction</li>\n       <li class=\"li\">Set settlement status</li>\n       <li class=\"li\">Premium payment</li>\n       <li class=\"li\">Perform period-end closing</li>\n       <li class=\"li\">Decide to Exercise</li>\n       <li class=\"li\">Decide to Expire</li>\n       <li class=\"li\">Perform Reporting</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio99a90b074d8048dd8687b3b493e676d6__business_benefits\">\n      <h2 class=\"title sectiontitle\">Business Benefits</h2>\n      <ul class=\"ul\" id=\"loio99a90b074d8048dd8687b3b493e676d6__ul_ubk_wrc_hxb\">\n       <li class=\"li\">Review the status for Securities Option instruments easily</li>\n       <li class=\"li\">Support the management of Securities Option, including creation of security class, security accounts and the transactions, payments, exercise or expire, and so on</li>\n       <li class=\"li\">Make better operational and strategic decisions using the comprehensive reporting and analysis tools</li>\n       <li class=\"li\">Improve internal operational compliance</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
 "description_zh_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>证券期权管理 (6ND)</title>\n </head>\n <body id=\"loio99a90b074d8048dd8687b3b493e676d6\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio99a90b074d8048dd8687b3b493e676d6__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">概览</h2>\n      <p class=\"p\">该范围项目可帮助您更好地管理证券期权工具。</p>\n      <p class=\"p\">它可以帮助您自动化劳动密集型流程（例如付款处理和会计过账），为您提供更多时间来关注增值活动。您可以管理运营和会计要求。</p>\n     </section>\n     <section class=\"section\" id=\"loio99a90b074d8048dd8687b3b493e676d6__key_process_flow\">\n      <h2 class=\"title sectiontitle\">关键流程流</h2>\n      <ul class=\"ul\" id=\"loio99a90b074d8048dd8687b3b493e676d6__ul_tbk_wrc_hxb\">\n       <li class=\"li\">创建证券账户和类</li>\n       <li class=\"li\">创建证券期权交易</li>\n       <li class=\"li\">设置结算状态</li>\n       <li class=\"li\">保险费支付</li>\n       <li class=\"li\">执行期末关账</li>\n       <li class=\"li\">决定行使</li>\n       <li class=\"li\">决定过期</li>\n       <li class=\"li\">执行报表</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio99a90b074d8048dd8687b3b493e676d6__business_benefits\">\n      <h2 class=\"title sectiontitle\">业务优势</h2>\n      <ul class=\"ul\" id=\"loio99a90b074d8048dd8687b3b493e676d6__ul_ubk_wrc_hxb\">\n       <li class=\"li\">轻松查看证券期权工具的状态</li>\n       <li class=\"li\">支持证券期权的管理，包括创建证券类、证券账户和交易、付款、行使或过期等</li>\n       <li class=\"li\">使用全面的报表和分析工具，制定更明智的运营和战略决策</li>\n       <li class=\"li\">提高内部运营合规性</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
