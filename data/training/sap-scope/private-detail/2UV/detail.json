 "description_en_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>Combined Invoice – Goods and Service Items (2UV)</title>\n </head>\n <body id=\"loiodba977c8d6d046508a8aeb9f2c1b2aab\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loiodba977c8d6d046508a8aeb9f2c1b2aab__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">Overview</h2>\n      <p class=\"p\">In some situations, you need to charge goods sold and services provided to the customer. Companies usually issue a Nota Fiscal for the services provided and another Nota Fiscal for the sale of goods, even if they are sold together. Some states and municipalities allow companies to issue a single Nota Fiscal (also known as a Nota Fiscal Conjugada) that covers both goods and services.</p>\n     </section>\n     <section class=\"section\" id=\"loiodba977c8d6d046508a8aeb9f2c1b2aab__key_process_flow\">\n      <h2 class=\"title sectiontitle\">Key Process Flow</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Perform basic credit management</li>\n       <li class=\"li\">Create sales order</li>\n       <li class=\"li\">Print form in NAST output with PDF</li>\n       <li class=\"li\">Manage printing form output</li>\n       <li class=\"li\">Create sales order using IFRS 15 bundling functionality</li>\n       <li class=\"li\">Provide advance Available-to-Promise processing</li>\n       <li class=\"li\">Create delivery</li>\n       <li class=\"li\">Print forms</li>\n       <li class=\"li\">Execute picking</li>\n       <li class=\"li\">Manage freight cost</li>\n       <li class=\"li\">Create billing documents</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loiodba977c8d6d046508a8aeb9f2c1b2aab__business_benefits\">\n      <h2 class=\"title sectiontitle\">Business Benefits</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Allow for a combined Nota Fiscal that covers goods and services</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
 "description_zh_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>组合发票 - 商品和服务项目 (2UV)</title>\n </head>\n <body id=\"loiodba977c8d6d046508a8aeb9f2c1b2aab\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loiodba977c8d6d046508a8aeb9f2c1b2aab__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">概览</h2>\n      <p class=\"p\">在某些情况下，您需要收取已售货物和提供给客户的服务。公司通常针对提供的服务开具发票，并为货物销售开具另一个发票，即使它们一起销售。一些州和自治市允许公司开具涵盖货物和服务的单个发票（也称为发票组合）。</p>\n     </section>\n     <section class=\"section\" id=\"loiodba977c8d6d046508a8aeb9f2c1b2aab__key_process_flow\">\n      <h2 class=\"title sectiontitle\">关键流程流</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">执行基本信用管理</li>\n       <li class=\"li\">创建销售订单</li>\n       <li class=\"li\">NAST 输出中的打印表单（含 PDF）</li>\n       <li class=\"li\">管理打印表单输出</li>\n       <li class=\"li\">使用 IFRS 15 捆绑功能创建销售订单</li>\n       <li class=\"li\">提供高级可承诺量处理</li>\n       <li class=\"li\">创建交货</li>\n       <li class=\"li\">打印表格</li>\n       <li class=\"li\">执行拣配</li>\n       <li class=\"li\">管理货运成本</li>\n       <li class=\"li\">创建开票凭证</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loiodba977c8d6d046508a8aeb9f2c1b2aab__business_benefits\">\n      <h2 class=\"title sectiontitle\">业务优势</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">允许包含货物和服务的合并发票。</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
