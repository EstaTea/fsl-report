 "description_en_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>Internal Order – Actual (BEV)</title>\n </head>\n <body id=\"loio8736d3f87e07486ea389143cebc4a4db\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio8736d3f87e07486ea389143cebc4a4db__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">Overview</h2>\n      <p class=\"p\">Various internal initiatives consume resources and incur costs or expenses. This process enables the tracking of costs incurred for these initiatives to facilitate cost control and monitoring, ROI calculations, settlement to other cost objects, and more.</p>\n     </section>\n     <section class=\"section\" id=\"loio8736d3f87e07486ea389143cebc4a4db__key_process_flow\">\n      <h2 class=\"title sectiontitle\">Key Process Flow</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Create master data</li>\n       <li class=\"li\">Assign costs</li>\n       <li class=\"li\">Settle costs to other receivers</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio8736d3f87e07486ea389143cebc4a4db__business_benefits\">\n      <h2 class=\"title sectiontitle\">Business Benefits</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Provides cost transparency into incurred resources used and expenses.</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
 "description_zh_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>内部订单 - 实际 (BEV)</title>\n </head>\n <body id=\"loio8736d3f87e07486ea389143cebc4a4db\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio8736d3f87e07486ea389143cebc4a4db__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">概览</h2>\n      <p class=\"p\">各种内部计划消耗资源并产生成本或费用。此流程支持跟踪这些计划产生的成本，以促进成本控制和监控、ROI 计算、结算到其他成本对象等。</p>\n     </section>\n     <section class=\"section\" id=\"loio8736d3f87e07486ea389143cebc4a4db__key_process_flow\">\n      <h2 class=\"title sectiontitle\">关键流程流</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">创建主数据</li>\n       <li class=\"li\">分配成本</li>\n       <li class=\"li\">将成本结算到其他接收方</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio8736d3f87e07486ea389143cebc4a4db__business_benefits\">\n      <h2 class=\"title sectiontitle\">业务优势</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">使产生的资源使用及费用的成本透明化。</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
