 "description_en_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>Contract Accounting – Integration with Sales Documents (43Y)</title>\n </head>\n <body id=\"loio738ac00ac244475d8093f2dfbcd6d502\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio738ac00ac244475d8093f2dfbcd6d502__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">Overview</h2>\n      <p class=\"p\">This scope item integrates Contract Accounting to provide invoicing of sales documents, allowing SD billable items to transfer to Convergent Contract Accounting (FI-CAC) for end-to-end invoice processing.</p>\n     </section>\n     <section class=\"section\" id=\"loio738ac00ac244475d8093f2dfbcd6d502__key_process_flow\">\n      <h2 class=\"title sectiontitle\">Key Process Flow</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Create sales order</li>\n       <li class=\"li\">Bill the invoice</li>\n       <li class=\"li\">Check FICA document</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio738ac00ac244475d8093f2dfbcd6d502__business_benefits\">\n      <h2 class=\"title sectiontitle\">Business Benefits</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Enable end-to-end invoicing process in <span class=\"ph pname\">SAP S/4HANA Cloud Private Edition</span> contract accounting</li>\n       <li class=\"li\">Transfer SD billing documents to contract accounting</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
 "description_zh_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>合同会计核算 – 与销售凭证集成 (43Y)</title>\n </head>\n <body id=\"loio738ac00ac244475d8093f2dfbcd6d502\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio738ac00ac244475d8093f2dfbcd6d502__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">概览</h2>\n      <p class=\"p\">此范围项目集成合同会计以提供销售凭证的开发票，允许 SD 可开票项目传输到集中合同会计 (FI-CAC) 以进行端到端发票处理。</p>\n     </section>\n     <section class=\"section\" id=\"loio738ac00ac244475d8093f2dfbcd6d502__key_process_flow\">\n      <h2 class=\"title sectiontitle\">关键流程流</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">创建销售订单</li>\n       <li class=\"li\">对发票开票</li>\n       <li class=\"li\">检查 FICA 凭证</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio738ac00ac244475d8093f2dfbcd6d502__business_benefits\">\n      <h2 class=\"title sectiontitle\">业务优势</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">在 <span class=\"ph pname\">SAP S/4HANA Cloud Private Edition</span> 合同会计中启用端到端开发票流程</li>\n       <li class=\"li\">将 SD 开票凭证传输到合同会计核算</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
