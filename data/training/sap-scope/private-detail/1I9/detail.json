 "description_en_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>Master Data Catalog for SAP S/4HANA – On-premise (1I9)</title>\n </head>\n <body id=\"loio30db22fd118148e3bf49dde7f722df27\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio30db22fd118148e3bf49dde7f722df27__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">Overview</h2>\n      <p class=\"p\">The list of individual master data objects shows all objects that are relevant for <span class=\"ph pname\">SAP S/4HANA Cloud Private Edition</span>, regardless of the scope you choose to implement.</p>\n     </section>\n     <section class=\"section\" id=\"loio30db22fd118148e3bf49dde7f722df27__key_process_flow\">\n      <h2 class=\"title sectiontitle\">Key Process Flow</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Customer master</li>\n       <li class=\"li\">Supplier master</li>\n       <li class=\"li\">Product master for Trading Good</li>\n       <li class=\"li\">Product master for Raw Material</li>\n       <li class=\"li\">Product master for Semi-Finished Good</li>\n       <li class=\"li\">Product master for Finished Good</li>\n       <li class=\"li\">G/L account</li>\n       <li class=\"li\">Cost element</li>\n       <li class=\"li\">Profit center</li>\n       <li class=\"li\">Asset</li>\n       <li class=\"li\">Production work center</li>\n       <li class=\"li\">Production bill of material</li>\n       <li class=\"li\">Routing</li>\n       <li class=\"li\">Cost center</li>\n       <li class=\"li\">Cost center group</li>\n       <li class=\"li\">Activity type</li>\n       <li class=\"li\">Activity type group</li>\n       <li class=\"li\">Cost element group</li>\n       <li class=\"li\">Costing run</li>\n       <li class=\"li\">SEPA Mandate</li>\n       <li class=\"li\">New open MM posting period</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio30db22fd118148e3bf49dde7f722df27__business_benefits\">\n      <h2 class=\"title sectiontitle\">Business Benefits</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Enable key users and implementation teams on best practices for master data maintenance</li>\n       <li class=\"li\">Lowers and accelerates the implementation effort</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
 "description_zh_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>SAP S/4HANA 的主数据目录 - 企业预置 (1I9)</title>\n </head>\n <body id=\"loio30db22fd118148e3bf49dde7f722df27\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio30db22fd118148e3bf49dde7f722df27__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">概览</h2>\n      <p class=\"p\">各个主数据对象的清单显示与 <span class=\"ph pname\">SAP S/4HANA Cloud Private Edition</span> 相关的所有对象，而不考虑您选择实施的范围。</p>\n     </section>\n     <section class=\"section\" id=\"loio30db22fd118148e3bf49dde7f722df27__key_process_flow\">\n      <h2 class=\"title sectiontitle\">关键流程流</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">客户主数据</li>\n       <li class=\"li\">供应商主数据</li>\n       <li class=\"li\">贸易货物的产品主数据</li>\n       <li class=\"li\">原材料的产品主数据</li>\n       <li class=\"li\">半成品的产品主数据</li>\n       <li class=\"li\">成品的产品主数据</li>\n       <li class=\"li\">总账科目</li>\n       <li class=\"li\">成本要素</li>\n       <li class=\"li\">利润中心</li>\n       <li class=\"li\">资产</li>\n       <li class=\"li\">生产工作中心</li>\n       <li class=\"li\">生产物料清单</li>\n       <li class=\"li\">工艺路线</li>\n       <li class=\"li\">成本中心</li>\n       <li class=\"li\">成本中心组</li>\n       <li class=\"li\">活动类型</li>\n       <li class=\"li\">活动类型组</li>\n       <li class=\"li\">成本要素组</li>\n       <li class=\"li\">成本核算运行</li>\n       <li class=\"li\">SEPA 授权</li>\n       <li class=\"li\">新的未清 MM 过账期间</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio30db22fd118148e3bf49dde7f722df27__business_benefits\">\n      <h2 class=\"title sectiontitle\">业务优势</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">支持关键用户和实施团队了解主数据维护的最佳实践。</li>\n       <li class=\"li\">减少并加速实施工作</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
