 "description_en_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>Group Reporting – Data from External Systems (2U6)</title>\n </head>\n <body id=\"loio66124b70e2df4eb584a9f47926a5e891\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio66124b70e2df4eb584a9f47926a5e891__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">Overview</h2>\n      <p class=\"p\">This scope item provides <span class=\"ph pname\">SAP S/4HANA Cloud Private Edition</span> customer the integration capabilities with external systems. This facilitates the customer to easily import or export the data with the <span class=\"ph pname\">SAP S/4HANA Cloud Private Edition</span> system.</p>\n     </section>\n     <section class=\"section\" id=\"loio66124b70e2df4eb584a9f47926a5e891__key_process_flow\">\n      <h2 class=\"title sectiontitle\">Key Process Flow</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Check communication scenario</li>\n       <li class=\"li\">Update data for consolidation unit (optional)</li>\n      </ul>\n      <p class=\"p\"></p>\n     </section>\n     <section class=\"section\" id=\"loio66124b70e2df4eb584a9f47926a5e891__business_benefits\">\n      <h2 class=\"title sectiontitle\">Business Benefits</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Provide API for reported data import</li>\n       <li class=\"li\">Easily import mass data into <span class=\"ph pname\">SAP S/4HANA Cloud Private Edition</span> system</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
 "description_zh_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>集团报表 - 来自外部系统的数据 (2U6)</title>\n </head>\n <body id=\"loio66124b70e2df4eb584a9f47926a5e891\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio66124b70e2df4eb584a9f47926a5e891__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">概览</h2>\n      <p class=\"p\">此范围项目为 <span class=\"ph pname\">SAP S/4HANA Cloud Private Edition</span> 客户提供与外部系统的集成功能。这有助于客户使用 <span class=\"ph pname\">SAP S/4HANA Cloud Private Edition</span> 系统轻松导入或导出数据。</p>\n     </section>\n     <section class=\"section\" id=\"loio66124b70e2df4eb584a9f47926a5e891__key_process_flow\">\n      <h2 class=\"title sectiontitle\">关键流程流</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">检查通信场景</li>\n       <li class=\"li\">更新合并单位的数据（可选）</li>\n      </ul>\n      <p class=\"p\"></p>\n     </section>\n     <section class=\"section\" id=\"loio66124b70e2df4eb584a9f47926a5e891__business_benefits\">\n      <h2 class=\"title sectiontitle\">业务优势</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">为报告的数据导入提供 API</li>\n       <li class=\"li\">轻松将批量数据导入到 <span class=\"ph pname\">SAP S/4HANA Cloud Private Edition</span> 系统</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
