 "description_en_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>Group Financial Planning (5PU)</title>\n </head>\n <body id=\"loio2b1408e47c7c40558eaa67d39559a4ae\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio2b1408e47c7c40558eaa67d39559a4ae__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">Overview</h2>\n      <p class=\"p\">This process supports detailed group financial planning. It includes P&amp;L planning, P&amp;L planning by partner, balance sheet planning, and balance sheet planning by partner.</p>\n     </section>\n     <section class=\"section\" id=\"loio2b1408e47c7c40558eaa67d39559a4ae__key_process_flow\">\n      <h2 class=\"title sectiontitle\">Key Process Flow</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Perform P&amp;L Planning</li>\n       <li class=\"li\">Perform P&amp;L Planning by Partner</li>\n       <li class=\"li\">Perform Balance sheet Planning</li>\n       <li class=\"li\">Perform Balance sheet Planning by Partner</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio2b1408e47c7c40558eaa67d39559a4ae__business_benefits\">\n      <h2 class=\"title sectiontitle\">Business Benefits</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Provides capability for group level's balance sheet planning and P&amp;L planning</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
 "description_zh_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>集团财务计划 (5PU)</title>\n </head>\n <body id=\"loio2b1408e47c7c40558eaa67d39559a4ae\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loio2b1408e47c7c40558eaa67d39559a4ae__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">概览</h2>\n      <p class=\"p\">此流程支持详细的集团财务计划。其中包括损益计划、合作伙伴损益计划、资产负债表计划和合作伙伴资产负债表计划。</p>\n     </section>\n     <section class=\"section\" id=\"loio2b1408e47c7c40558eaa67d39559a4ae__key_process_flow\">\n      <h2 class=\"title sectiontitle\">关键流程流</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">执行损益计划</li>\n       <li class=\"li\">按合作伙伴执行损益计划</li>\n       <li class=\"li\">执行资产负债表计划</li>\n       <li class=\"li\">执行资产负债表计划（按合作伙伴）</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loio2b1408e47c7c40558eaa67d39559a4ae__business_benefits\">\n      <h2 class=\"title sectiontitle\">业务优势</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">提供组级别的资产负债表计划和损益计划的功能。</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
