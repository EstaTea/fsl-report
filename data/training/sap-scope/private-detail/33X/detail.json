 "description_en_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>Contract Accounting – Group Ledger IFRS (33X)</title>\n </head>\n <body id=\"loioaa3230afef2348daac3cd6699c571694\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loioaa3230afef2348daac3cd6699c571694__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">Overview</h2>\n      <p class=\"p\">In this scope item, you handle ledger-specific transactions and reports for IFRS within Contract Accounting. This includes Doubtful Receivables, Foreign Currency Valuation, Day-End Closing, and Month-End Closing.</p>\n     </section>\n     <section class=\"section\" id=\"loioaa3230afef2348daac3cd6699c571694__key_process_flow\">\n      <h2 class=\"title sectiontitle\">Key Process Flow</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Review doubtful receivables</li>\n       <li class=\"li\">Perform foreign currency valuation</li>\n       <li class=\"li\">Perform day-end and month-end closing</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loioaa3230afef2348daac3cd6699c571694__business_benefits\">\n      <h2 class=\"title sectiontitle\">Business Benefits</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">Support IFRS accounting principles</li>\n       <li class=\"li\">Ensure complete and accurate accounting data in parallel accounting</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
 "description_zh_html": "<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html lang=\"en-us\">\n <head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"copyright\" content=\"(C) Copyright 2025\">\n  <meta name=\"generator\" content=\"DITA-OT\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"commonltr.css\">\n  <title>合同会计 – 集团分类账 IFRS (33X)</title>\n </head>\n <body id=\"loioaa3230afef2348daac3cd6699c571694\">\n  <main role=\"main\">\n   <article role=\"article\" aria-labelledby=\"ariaid-title1\">\n    <div class=\"body conbody\">\n     <section class=\"section\" id=\"loioaa3230afef2348daac3cd6699c571694__sol_var_overview\">\n      <h2 class=\"title sectiontitle\">概览</h2>\n      <p class=\"p\">在此范围项目中，您可以处理合同会计中 IFRS 的分类账特定交易和报表。这包括坏账、外币评估、日终关账和月末关账。</p>\n     </section>\n     <section class=\"section\" id=\"loioaa3230afef2348daac3cd6699c571694__key_process_flow\">\n      <h2 class=\"title sectiontitle\">关键流程流</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">检查坏账应收账款</li>\n       <li class=\"li\">执行外币评估</li>\n       <li class=\"li\">执行日终和月末关账</li>\n      </ul>\n     </section>\n     <section class=\"section\" id=\"loioaa3230afef2348daac3cd6699c571694__business_benefits\">\n      <h2 class=\"title sectiontitle\">业务优势</h2>\n      <ul class=\"ul\">\n       <li class=\"li\">支持 IFRS 会计准则</li>\n       <li class=\"li\">确保并行会计中完整、准确的会计数据</li>\n      </ul>\n     </section>\n    </div>\n   </article>\n  </main>\n </body>\n</html>",
